RewriteEngine On
DirectoryIndex index.html
# la app: /app/ y una pagina por ciudad (las ciudades viejas siguen abriendo la app)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(app|foz|chapeco|florianopolis|curitiba|portoalegre|cordoba|saopaulo|rio|iguazu|londrina|pontagrossa|guarapuava|franciscobeltrao|umuarama|campomourao|jacarezinho|uniaodavitoria|joinville|blumenau|lages|criciuma|passofundo|caxiasdosul|santamaria|santacruzdosul|uruguaiana|pelotas|carlospaz|vgbelgrano|altagracia|minaclavero|jesusmaria|riocuarto|villamaria)/?$ /app.html [L]
